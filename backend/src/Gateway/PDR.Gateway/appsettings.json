{
  "Api": {
    "Title": "PDR Gateway",
    "Version": "v1",
    "RateLimitPermitPerMinute": 1200,
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "Authentication": {
    "Keycloak": {
      "Authority": "http://localhost:8080/realms/pdr",
      "Audience": "pdr-api",
      "ResourceClient": "pdr-api",
      "RequireHttpsMetadata": false,
      "Enabled": true
    }
  },
  "Observability": {
    "SeqUrl": "",
    "OtlpEndpoint": ""
  },
  "ReverseProxy": {
    "Routes": {
      "release-notes": {
        "ClusterId": "release-notes",
        "Match": {
          "Path": "/api/v1/releases/{**catch-all}"
        }
      },
      "release-notes-root": {
        "ClusterId": "release-notes",
        "Match": {
          "Path": "/api/v1/releases"
        }
      },
      "release-notes-settings-root": {
        "ClusterId": "release-notes",
        "Match": {
          "Path": "/api/v1/settings"
        }
      },
      "release-notes-admin": {
        "ClusterId": "release-notes",
        "Match": {
          "Path": "/api/v1/admin/releases/{**catch-all}"
        }
      },
      "release-notes-settings": {
        "ClusterId": "release-notes",
        "Match": {
          "Path": "/api/v1/settings/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "release-notes": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5101/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
