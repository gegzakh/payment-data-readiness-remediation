        "Match": {
          "Path": "/api/v1/audit/{**catch-all}"
        }
      },
      "audit-root": {
        "ClusterId": "audit",
        "Match": {
          "Path": "/api/v1/audit"
        }
      },
      "service-settings": {
        "ClusterId": "release-notes",
        "Match": {
          "Path": "/api/v1/services/release-notes/settings/{**catch-all}"
