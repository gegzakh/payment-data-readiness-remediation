{
  "realm": "pdr",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 1800,
  "clients": [
    {
      "clientId": "pdr-api",
      "name": "PDR APIs",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "secret": "pdr-api-dev-secret",
      "defaultRoles": [],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "pdr-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "pdr-web",
      "name": "PDR Web UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:5173",
      "redirectUris": ["http://localhost:5173/*", "http://localhost:5174/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:5174"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience-pdr-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "pdr-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "pdr-api": [
        { "name": "releasenotes.read" },
        { "name": "releasenotes.write" },
        { "name": "releasenotes.publish" },
        { "name": "rules.read" },
        { "name": "rules.write" },
        { "name": "rules.activate" },
        { "name": "audit.read" },
        { "name": "audit.write" },
        { "name": "audit.verify" },
        { "name": "settings.read" },
        { "name": "settings.write" },
        { "name": "sources.read" },
        { "name": "sources.write" },
        { "name": "sources.attest" },
        { "name": "ingestion.read" },
        { "name": "ingestion.write" },
        { "name": "ingestion.manage" },
        { "name": "validation.read" },
        { "name": "validation.run" },
        { "name": "validation.drilldown" }
      ]
    }
  },
  "users": [
    {
      "username": "pdr-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "pdr-admin@example.local",
      "firstName": "Pat",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "pdr-admin", "temporary": false }],
      "clientRoles": {
        "pdr-api": [
          "releasenotes.read",
          "releasenotes.write",
          "releasenotes.publish",
          "rules.read",
          "rules.write",
          "rules.activate",
          "audit.read",
          "audit.write",
          "audit.verify",
          "settings.read",
          "settings.write",
          "sources.read",
          "sources.write",
          "sources.attest",
          "ingestion.read",
          "ingestion.write",
          "ingestion.manage",
          "validation.read",
          "validation.run",
          "validation.drilldown"
        ]
      }
    },
    {
      "username": "pdr-user",
      "enabled": true,
      "emailVerified": true,
      "email": "pdr-user@example.local",
      "firstName": "Sam",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "pdr-user", "temporary": false }],
      "clientRoles": {
        "pdr-api": [
          "releasenotes.read",
          "rules.read",
          "audit.read",
          "sources.read",
          "ingestion.read",
          "validation.read"
        ]
      }
    }
  ]
}
